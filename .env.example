# ID de um projeto Google Cloud autorizado para sua conta Earth Engine.
EARTH_ENGINE_PROJECT=seu-projeto-gcp-autorizado

# Earth Engine na Vercel sem chave privada (Workload Identity Federation).
# Preencha as quatro variaveis juntas para ativar esse modo. Se todas estiverem
# vazias, a autenticacao local existente continua em uso.
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=
# A Vercel fornece o token em x-vercel-oidc-token; nao copie tokens para o Git
# ou para variaveis de Production. OIDC deve estar ativo em Settings > Security.

# NASA POWER nao exige chave, token ou login. Use 08_testar_nasa_power.bat.

# Persistencia de producao (somente no backend / Vercel).
# Prefira a Secret Key moderna (sb_secret_...). A service_role legada tambem e
# aceita pela aplicacao como SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=

# IA no backend. Nunca use o prefixo VITE_ ou REACT_APP_ nesta chave.
OPENAI_API_KEY=

# Geocodificacao de endereco completo. O padrao usa o endpoint publico do
# Nominatim com cache e limite de 1 requisicao/segundo. Em operacao de maior
# volume, a URL pode apontar para uma instancia propria ou provedor compativel.
AGRISHIELD_GEOCODING_URL=https://nominatim.openstreetmap.org/search
AGRISHIELD_GEOCODING_USER_AGENT=AgriShield/1.0 (https://seu-dominio.example)

# Protege todos os endpoints /api/* com uma sessao confirmada e aprovada.
# Na Vercel isso ja fica ativo por padrao; mantenha explicito em producao.
AGRISHIELD_AUTH_REQUIRED=true

# Origens do frontend autorizadas no CORS, separadas por virgula.
# Exemplo: https://agrishield.vercel.app,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
