{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{backend/tests/**,backend/scripts/**,backend/validacao/**,frontend/**,docs/**,output/**,**/*.bat}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
