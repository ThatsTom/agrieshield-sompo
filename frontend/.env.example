VITE_API_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
# Chave publica de login. Nunca use SUPABASE_SECRET_KEY ou service_role aqui.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Para testar o frontend local com o backend remoto, use as duas linhas abaixo
# no .env.local e reinicie o Vite. O proxy preserva a autenticacao da API.
# VITE_API_URL=http://127.0.0.1:5173
# AGRISHIELD_DEV_API_TARGET=https://agrishield-sompo-backend.vercel.app
# AGRISHIELD_DEV_API_TARGET e lida apenas pelo servidor de desenvolvimento;
# nao e incluida no JavaScript enviado ao navegador.
